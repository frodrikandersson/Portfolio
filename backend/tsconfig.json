{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",           // 👈 Add this line
    "rootDir": "src"            // 👈 Optional, if your .ts files are in 'src'
  },
  "include": ["src/**/*"]
}

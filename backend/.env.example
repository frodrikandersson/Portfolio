# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=QuilCount

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# CORS - Frontend URL (Vercel URL in production)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: Custom product files directory
# PRODUCT_FILES_DIR=/path/to/product-files

# Cloudflare R2 Storage (optional - for persistent image storage)
# Get these from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ENDPOINT=https://[account-id].r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=quilcount
R2_PUBLIC_URL=https://pub-xxx.r2.dev
